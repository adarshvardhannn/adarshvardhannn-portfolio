# Web3Forms API Key
# 1. Server-side (Vercel Serverless Function — 100% hidden from browser):
WEB3FORMS_ACCESS_KEY=your_access_key_here
# 2. Local dev fallback:
VITE_WEB3FORMS_ACCESS_KEY=your_access_key_here

# Frontend URL (leave empty when deploying to Vercel to use relative /api/contact)
VITE_API_URL=

# PostgreSQL (Only needed if running local Express server)
DATABASE_URL=postgresql://user:password@localhost:5432/portfolio

# Redis (Only needed if running local Express server)
REDIS_URL=redis://localhost:6379

# CORS — frontend origin
FRONTEND_URL=http://localhost:5173

# Contact email recipient
CONTACT_RECEIVER_EMAIL=adarshraj5206@gmail.com

# SMTP configuration (Only needed if running local Express server)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Security — used to hash IP addresses and user-agents
IP_HASH_SECRET=change-this-to-a-random-secret
